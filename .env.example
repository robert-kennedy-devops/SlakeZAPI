# ── Server ─────────────────────────────────────────────────
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=10s

# ── Database ────────────────────────────────────────────────
# sslmode=disable is fine for local dev. Use sslmode=require (or verify-full) in production.
DATABASE_URL=postgres://saas:saaspassword@localhost:5432/whatsapp_saas?sslmode=disable
POSTGRES_USER=saas
POSTGRES_PASSWORD=saaspassword
POSTGRES_DB=whatsapp_saas
POSTGRES_PORT=5432
DB_MAX_CONNECTIONS=20

# ── Security ────────────────────────────────────────────────
# IMPORTANT: Change all secrets below to long random strings in production!

# Bootstrap endpoint: POST /auth/bootstrap requires this header: X-Bootstrap-Secret: <value>
# Leave empty to DISABLE the endpoint entirely (recommended in production after first setup).
BOOTSTRAP_SECRET=

# Salt used to hash API keys — must be changed before first deploy.
API_KEY_SALT=change-me-in-production-use-a-long-random-secret
USER_ACCESS_TOKEN_TTL=15m
USER_REFRESH_TOKEN_TTL=168h
USER_SESSION_COOKIE_NAME=slakezapi_rt
USER_SESSION_COOKIE_SECURE=false
USER_SESSION_COOKIE_DOMAIN=
USER_SESSION_COOKIE_SAMESITE=lax

# ── WhatsApp ────────────────────────────────────────────────
WHATSAPP_DATA_PATH=./data/whatsapp

# ── Queue ───────────────────────────────────────────────────
WORKER_COUNT=10
QUEUE_BUFFER_SIZE=500

# ── Webhooks ────────────────────────────────────────────────
WEBHOOK_TIMEOUT=10s
WEBHOOK_RETRIES=3

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_RPS=10
# Max requests per minute per IP for login / signup / refresh (default: 20)
AUTH_RATE_LIMIT_RPM=20

# ── Metrics ─────────────────────────────────────────────────
# If set, GET /metrics requires: Authorization: Bearer <token>
# If empty, only loopback (127.0.0.1) is allowed — external access is blocked.
METRICS_TOKEN=

# ── Frontend / CORS ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3000
